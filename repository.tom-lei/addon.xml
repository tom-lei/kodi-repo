<?xml version="1.0" encoding="UTF-8"?>
<addon id="repository.tom-lei"
       name="kodi-repo"
       version="1.0.0"
       provider-name="tom-lei">
  <requires>
    <import addon="xbmc.addon" version="12.0.0"/>
  </requires>
  <extension point="xbmc.addon.repository" name="kodi-repo">
    <dir>
      <info compressed="false">https://tom-lei.github.io/kodi-repo/addons.xml</info>
      <checksum verify="sha256">https://tom-lei.github.io/kodi-repo/addons.xml.sha256</checksum>
      <datadir zip="true">https://tom-lei.github.io/kodi-repo/</datadir>
      <hashes>sha256</hashes>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Kodi add-on repository</summary>
    <description lang="en_GB">A repository for separately released Kodi add-ons.</description>
    <platform>all</platform>
    <license>GPL-3.0-or-later</license>
    <source>https://github.com/tom-lei/kodi-repo</source>
    <website>https://tom-lei.github.io/kodi-repo/</website>
    <email></email>
    <news>Initial repository release.</news>
  </extension>
</addon>
